# ---------------------------------------------------------------------------
# NAWI-ReportPro — Backend Environment Template
# ---------------------------------------------------------------------------
# Copy this file to `server/.env` for a stable local setup:
#     cp server/.env.example server/.env
#
# You do NOT need to do this just to evaluate the portal. With no .env present
# the server generates random ephemeral secrets at startup and runs on the
# in-memory demo database, so `npm run dev` works on a clean clone.
#
# In production (`NODE_ENV=production`) the server REFUSES to start unless
# JWT_SECRET and HMAC_SECRET are explicitly configured.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. If this database is unreachable the server
# automatically falls back to the fully-seeded in-memory demo database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nawi_reportpro

# Signs officer authentication tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-value

# Keys the HMAC tamper-evident digital verification seal applied to sealed
# certificates. Changing this invalidates every previously issued seal.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HMAC_SECRET=replace-me-with-a-long-random-value

# API server port.
PORT=5000

# development | production | test
NODE_ENV=development

# Browser origin permitted by CORS. Leave unset in development to allow any origin.
CLIENT_ORIGIN=http://localhost:3000
